# PostgreSQL — Railway מספק את זה אוטומטית כשמוסיפים שירות Postgres
DATABASE_URL=postgres://user:password@host:5432/dbname
# רק אם החיבור דורש SSL מפורש (חיבור חיצוני, לא ברשת הפרטית של Railway)
PGSSL=false

PORT=3000
NODE_ENV=production

# מפתח אקראי וסודי לחתימת עוגיית ה-session (למשל: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret

# ====== סיסמת מנהל ראשונית (משמש רק את scripts/set-admin-password.js) ======
INITIAL_ADMIN_PASSWORD=

# ====== ימות המשיח — API לשליחת SMS (קודי אימות) ======
# מפתח API יחיד מהאזור האישי באתר ימות המשיח (מתחיל ב-"apik_..."). לא צריך
# בנוסף מספר-מערכת+סיסמה — המפתח הזה לבדו הוא ה-token שנשלח ל-SendSms.
YEMOT_SMS_API_KEY=

# ====== נדרים פלוס — יתווסף בשלב הבא (עדיין לא בשימוש בקוד) ======
# NEDARIM_MOSAD_ID=
# NEDARIM_API_VALID=
# NEDARIM_WEBHOOK_SECRET=
