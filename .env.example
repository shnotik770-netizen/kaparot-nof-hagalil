# PostgreSQL — Railway מספק את זה אוטומטית כשמוסיפים שירות Postgres
DATABASE_URL=postgres://user:password@host:5432/dbname
# רק אם החיבור דורש SSL מפורש (חיבור חיצוני, לא ברשת הפרטית של Railway)
PGSSL=false

PORT=3000
NODE_ENV=production

# מפתח אקראי וסודי לחתימת עוגיית ה-session (למשל: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret

# ====== סיסמת מנהל ראשונית (משמש רק את scripts/set-admin-password.js) ======
INITIAL_ADMIN_PASSWORD=

# ====== ימות המשיח — API לשליחת SMS (קודי אימות) ======
# מפתח API יחיד מהאזור האישי באתר ימות המשיח (מתחיל ב-"apik_..."). לא צריך
# בנוסף מספר-מערכת+סיסמה — המפתח הזה לבדו הוא ה-token שנשלח ל-SendSms.
YEMOT_SMS_API_KEY=

# ====== נדרים פלוס — שיטה 3 מסלול ב' (עסקה שהוקמה בשרת), ראו docs/nedarim-plus-integration.md ======
# מספר המוסד (7 ספרות) — עדיין לא התקבל
NEDARIM_MOSAD_ID=
# סיסמת האימות לדף התשלום (לא סוד מוחלט, אבל נשמר בשרת) — מוצג בראש הגדרות > API > מפתחות API
NEDARIM_API_VALID=
# מפתח חתימת HMAC (whsec_...) — מוגרל ומופעל בהגדרות > API > Webhook. בלעדיו
# ה-Webhook מעובד ב"מצב רך" (לא חסום, רק מוזהר בלוג) — יש להגדיר לפני עלייה לאוויר בפועל
NEDARIM_WEBHOOK_SECRET=
# כתובת הבסיס הציבורית של השרת (לבניית כתובת ה-Webhook שנשלחת לנדרים פלוס).
# ברירת מחדל: נגזר אוטומטית מ-RAILWAY_PUBLIC_DOMAIN — נדרש רק אם יש דומיין מותאם אישית
# PUBLIC_BASE_URL=https://kaparot.example.org
